{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splatforge.local/schemas/benchmark_baseline.schema.json",
  "title": "SplatForge trusted benchmark baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "benchmark_id",
    "benchmark_definition_digest",
    "environment_id",
    "subject_revision",
    "raw_samples",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "trusted_ci"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_definition_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject_revision": {"type": "string", "minLength": 1},
    "raw_samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["case_id", "implementation_id", "sample_count", "median_ms", "mad_ms", "peak_allocated_bytes"]
      }
    }
  }
}
