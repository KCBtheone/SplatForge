{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splatforge.local/schemas/work_order.schema.json",
  "title": "SplatForge provider work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "base_commit",
    "packet_digest",
    "packet_digest_algorithm",
    "packet_digest_excludes",
    "op_id",
    "op_spec_revision",
    "implementation_id",
    "goal",
    "network_mode",
    "fresh_context_required",
    "allowed_paths",
    "forbidden_paths",
    "frozen_inputs",
    "required_commands",
    "required_self_reports",
    "automatic_failure",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
    },
    "status": {"enum": ["draft_not_executable", "frozen", "closed"]},
    "blocking_requirements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "base_commit": {"type": "string", "minLength": 1},
    "packet_digest": {"type": "string", "minLength": 1},
    "packet_digest_algorithm": {"const": "splatforge-packet-payload-v1"},
    "packet_digest_excludes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["WORK_ORDER.yaml", "PACK_MANIFEST.json"]}
    },
    "op_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+@[1-9][0-9]*$"
    },
    "op_spec_revision": {"type": "string", "minLength": 1},
    "implementation_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "network_mode": {"enum": ["off", "allowlist_proxy"]},
    "fresh_context_required": {"type": "boolean"},
    "inherit_current_conversation": {"type": "boolean"},
    "context_inventory_required": {"type": "boolean"},
    "tool_access_log_required": {"type": "boolean"},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "supported_cells": {"type": "object"},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "frozen_inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_policy": {"type": "object"},
    "required_commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_self_reports": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance": {"type": "object"},
    "automatic_failure": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "submission_prompt": {"type": "string", "minLength": 1}
  }
}
